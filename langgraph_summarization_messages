      "cell_type": "code",
      "source": [
        "def ask_question(state:State)->State:\n",
        "  print(f\"\\n--------------> Entering ask_question:\")\n",
        "  question=\"what is your question?\"\n",
        "  print(question)\n",
        "  return State(messages=[AIMessage(question),HumanMessage(input())])\n"
      ],
      "metadata": {
        "id": "y8C1UbsCpYDE"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def chatbot(state:State)->State:\n",
        "  print(f\"\\n------------->Entering chatbot:\")\n",
        "\n",
        "  for i in state[\"messages\"]:\n",
        "    i.pretty_print()\n",
        "\n",
        "  system_message=f'''\n",
        "    Here's a quick summary of what we have discussed so far\n",
        "    {state.get(\"summary\",\"\")}\n",
        "\n",
        "    keep this in mind as you answer the next question\n",
        "\n",
        "\n",
        "  '''\n",
        "\n",
        "  response=chat.invoke([system_message+state[\"messages\"]])\n",
        "  return State(messages=[response])"
      ],
      "metadata": {
        "id": "7gFjU6v_1Ftc"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def ask_another_question(state:State)->State:\n",
        "  print(f\"\\n------------>Entering ask_another_question:\")\n",
        "\n",
        "  question=\"would you like to continue? (yes/no)\"\n",
        "  print(question)\n",
        "  return State(messages=[input()])"
      ],
      "metadata": {
        "id": "DDbTBZNN1IG6"
      },
      "execution_count": 17,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def summarize_and_delete_messages(state:State)->State:\n",
        "  print(f\"\\n---------->Entering summarize_and_delete_messages:\")\n",
        "  new_conversations=\"\"\n",
        "\n",
        "  for i in state[\"messages\"]:\n",
        "    new_conversations+=f\"{i.type}:{i.content}\\n\\n\"\n",
        "\n",
        "  summary_instructions=f'''\n",
        "  update the ongoing summary by incorporating the new lines of conversations below .\n",
        "  Build upon the previous summary rather than repeating it so that the result reflects the most recent context and developments\n",
        "\n",
        "  Previous Summary:\n",
        "  {state.get(\"summary\",\"\")}\n",
        "\n",
        "  New conversations:\n",
        "  {new_conversations}\n",
        "\n",
        "  '''\n",
        "  print(summary_instructions)\n",
        "\n",
        "  summary=chat.invoke([HumanMessage(summary_instructions)])\n",
        "  remove_messages=[RemoveMessage(id=i.id) for i in state[\"messages\"][:]]\n",
        "  return State(messages=remove_messages,summary=summary.content)"
      ],
      "metadata": {
        "id": "3JtmQTWV1k4-"
      },
      "execution_count": 22,
      "outputs": []
